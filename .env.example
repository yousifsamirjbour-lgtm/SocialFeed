# Database (PostgreSQL with asyncpg)
# Local PostgreSQL:
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/socialfeed
# Supabase Direct / Session Pooler (Port 5432):
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Supabase Transaction Pooler (Port 6543) - statement_cache_size: 0 is automatically applied in db.py:
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Authentication
JWT_SECRET_KEY=your_jwt_secret_key_here

# Groq LLM API
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Web Search
TAVILY_API_KEY=your_tavily_api_key_here

# Image Generation
POLLINATIONS_API_KEY=your_pollinations_api_key_here

# Vector Embeddings (Reserved for future pgvector retriever)
GOOGLE_API_KEY=your_google_api_key_here

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Studio Cost & Rate Limit Controls ($0.00 Guarantee)
AI_STUDIO_USER_RATE_LIMIT_PER_HOUR=5
AI_STUDIO_GLOBAL_DAILY_CAP=50
AI_STUDIO_MAX_CRITIQUE_ROUNDS=2
AI_STUDIO_MAX_SEARCH_RESULTS=3
AI_STUDIO_MAX_QUERY_LENGTH=300
AI_STUDIO_CACHE_TTL_SECONDS=300

# LangSmith Tracing (Optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key_here

# Supabase Configuration
# Note: For vector similarity search with pgvector, run in Supabase SQL editor:
# CREATE EXTENSION IF NOT EXISTS vector;
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

